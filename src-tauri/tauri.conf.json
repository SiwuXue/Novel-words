{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "novel-words",
  "version": "0.1.0",
  "identifier": "com.tauri-app.novel-words",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "词阅",
        "width": 960,
        "height": 640,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/dictionary.db",
      "resources/CET4luan_1.json",
      "resources/CET4luan_2.json",
      "resources/CET6_2.json",
      "resources/CET6luan_1.json",
      "resources/ChuZhongluan_2.json",
      "resources/GaoZhongluan_2.json",
      "resources/KaoYan_2.json",
      "resources/KaoYanluan_1.json",
      "resources/Level4luan_1.json",
      "resources/Level4luan_2.json",
      "resources/Level8_1.json",
      "resources/Level8luan_2.json"
    ]
  }
}
